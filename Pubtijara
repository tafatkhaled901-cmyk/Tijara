<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Tijara — Votre boutique en ligne en 5 minutes</title>
<meta name="description" content="Répondez à 3 questions et découvrez comment vendre en ligne en Algérie, paiement à la livraison.">
<meta name="theme-color" content="#3D53F5">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Plus+Jakarta+Sans:wght@400;500;700&family=Noto+Kufi+Arabic:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{
  --bleu:#3D53F5;
  --bleu-fonce:#1B2470;
  --encre:#0E1330;
  --papier:#F5F6FB;
  --menthe:#00C48C;
  --or:#FFB800;
  --gris:#5E6588;
  --trait:rgba(14,19,48,.10);
  --r:16px;
}
*{box-sizing:border-box;margin:0;padding:0}
body{
  background:var(--papier);color:var(--encre);
  font-family:"Plus Jakarta Sans",system-ui,sans-serif;
  font-size:17px;line-height:1.5;min-height:100vh;
  display:flex;flex-direction:column;
  -webkit-font-smoothing:antialiased;
  padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom);
}
body.ar{font-family:"Noto Kufi Arabic",sans-serif}
[lang=ar]{font-family:"Noto Kufi Arabic",sans-serif;direction:rtl}

/* ---- en-tête : langue + progression ---- */
.top{position:sticky;top:0;z-index:20;background:var(--papier);border-bottom:1px solid var(--trait)}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:12px 18px 8px;max-width:600px;margin:0 auto}
.marque{font-family:"Space Grotesk",sans-serif;font-weight:700;font-size:21px;letter-spacing:-.02em;color:var(--bleu)}
.marque i{font-style:normal;color:var(--menthe)}
.langue{display:flex;gap:4px;background:rgba(61,83,245,.08);border-radius:99px;padding:3px}
.langue button{border:0;background:none;font:600 13px/1 inherit;padding:7px 12px;border-radius:99px;color:var(--gris);cursor:pointer}
.langue button[aria-pressed=true]{background:#fff;color:var(--bleu);box-shadow:0 1px 3px rgba(14,19,48,.12)}

.rail{height:5px;background:rgba(61,83,245,.14)}
.fill{height:100%;width:0;background:linear-gradient(90deg,var(--bleu),var(--menthe));transition:width .45s cubic-bezier(.4,0,.2,1)}

main{flex:1;display:flex;flex-direction:column;justify-content:center;width:100%;max-width:600px;margin:0 auto;padding:26px 18px 44px}
.etape{display:none;animation:monte .45s cubic-bezier(.2,.8,.2,1) both}
.etape.on{display:block}
@keyframes monte{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

.compteur{font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--bleu);margin-bottom:12px}
h1{font-family:"Space Grotesk",sans-serif;font-weight:700;font-size:clamp(29px,7.5vw,40px);line-height:1.08;letter-spacing:-.025em;margin-bottom:14px}
h1 em{font-style:normal;background:linear-gradient(180deg,transparent 62%,rgba(255,184,0,.45) 62%)}
h2{font-family:"Space Grotesk",sans-serif;font-weight:700;font-size:clamp(22px,5.6vw,28px);line-height:1.18;letter-spacing:-.015em;margin-bottom:8px}
.sous{color:var(--gris);margin-bottom:24px}
body.ar h1,body.ar h2{font-family:"Noto Kufi Arabic",sans-serif;line-height:1.35}

.choix{display:flex;flex-direction:column;gap:10px}
.opt{
  display:flex;align-items:center;gap:14px;width:100%;text-align:start;
  background:#fff;border:1.5px solid var(--trait);border-radius:var(--r);
  padding:16px 17px;font:inherit;color:inherit;cursor:pointer;
  transition:border-color .15s,transform .12s,box-shadow .15s;
}
.opt:hover{border-color:var(--bleu);box-shadow:0 4px 14px rgba(61,83,245,.10)}
.opt:active{transform:scale(.985)}
.opt:focus-visible{outline:3px solid var(--or);outline-offset:2px}
.opt .ico{font-size:26px;line-height:1;flex:none}
.opt b{display:block;font-weight:700;font-size:16px}
.opt small{display:block;font-size:13.5px;color:var(--gris);margin-top:2px;font-weight:400}

label{display:block;font-size:13px;font-weight:700;color:var(--gris);margin-bottom:6px}
input{width:100%;padding:15px 17px;font:inherit;background:#fff;border:1.5px solid var(--trait);border-radius:var(--r);margin-bottom:14px}
input:focus{outline:3px solid var(--or);outline-offset:1px;border-color:var(--bleu)}
.err{display:none;color:#D62828;font-size:14px;font-weight:500;margin-bottom:10px}

.cta{
  display:block;width:100%;padding:18px;text-align:center;text-decoration:none;
  font:700 17px/1.2 "Plus Jakarta Sans",sans-serif;
  background:var(--bleu);color:#fff;border:0;border-radius:var(--r);cursor:pointer;
  box-shadow:0 6px 18px rgba(61,83,245,.32);
}
body.ar .cta{font-family:"Noto Kufi Arabic",sans-serif}
.cta:active{transform:scale(.99)}
.cta:focus-visible{outline:3px solid var(--or);outline-offset:2px}
.cta.vert{background:var(--menthe);box-shadow:0 6px 18px rgba(0,196,140,.3)}
.retour{background:none;border:0;color:var(--gris);font:inherit;font-size:14px;padding:12px 0;cursor:pointer;text-decoration:underline}
.note{font-size:13.5px;color:var(--gris);text-align:center;margin-top:14px}

/* preuves sur l'accroche */
.preuves{display:flex;gap:8px;margin:22px 0 26px}
.preuve{flex:1;background:#fff;border:1.5px solid var(--trait);border-radius:12px;padding:12px 8px;text-align:center}
.preuve b{display:block;font-family:"Space Grotesk",sans-serif;font-size:20px;color:var(--bleu)}
.preuve span{display:block;font-size:11.5px;color:var(--gris);line-height:1.3;margin-top:3px}

/* résultat */
.fiche{background:#fff;border:1.5px solid var(--trait);border-radius:20px;padding:24px 20px;margin-bottom:18px}
.tag{display:inline-block;background:var(--menthe);color:#fff;font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:6px 12px;border-radius:99px;margin-bottom:14px}
.fiche ul{list-style:none;margin-top:16px}
.fiche li{position:relative;padding:12px 0 12px 30px;border-top:1px solid var(--trait);font-size:15.5px}
[dir=rtl] .fiche li{padding:12px 30px 12px 0}
.fiche li:before{content:"✓";position:absolute;inset-inline-start:2px;top:12px;color:var(--menthe);font-weight:700}
.prix{display:flex;align-items:baseline;gap:8px;margin-top:18px;padding-top:16px;border-top:1px solid var(--trait)}
.prix b{font-family:"Space Grotesk",sans-serif;font-size:26px}
.prix span{font-size:14px;color:var(--gris)}
</style>
</head>
<body>

<header class="top">
  <div class="topbar">
    <div class="marque">Tijara<i>.</i></div>
    <div class="langue">
      <button id="bFr" aria-pressed="true">🇫🇷 Français</button>
      <button id="bAr" aria-pressed="false">🇩🇿 الدارجة</button>
