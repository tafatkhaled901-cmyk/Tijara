</main>

<script>
/* ================= réglages ================= */
const CONFIG = {
  endpoint: "https://formspree.io/f/mvkpqlew",
  inscription: "https://tafatkhaled901-cmyk.github.io/Tijara/?page=vendeur&tab=signup"
};

/* ================= contenu des résultats ================= */
const FICHES = {
  mode: {
    fr:{t:"Boutique mode",x:"Vos clientes voient les tailles disponibles avant de commander. Plus d'annulation après coup."},
    ar:{t:"حانوت الموضة",x:"الحرفاء يشوفو القياسات المتوفرة قبل ما يطلبو. ما بقاش الإلغاء من بعد."}
  },
  tech: {
    fr:{t:"Boutique high-tech",x:"Fiches produit avec photo et prix, page de vente dédiée pour vos meilleures références."},
    ar:{t:"حانوت الإلكترونيك",x:"بطاقات المنتجات بالتصويرة والثمن، وصفحة بيع خاصة لأحسن سلعك."}
  },
  beaute: {
    fr:{t:"Boutique beauté",x:"Rotation rapide, stock qui se met à jour seul, alerte avant la rupture."},
    ar:{t:"حانوت الزينة",x:"دوران سريع، ستوك يتحدّث وحدو، وتنبيه قبل ما يخلص."}
  },
  autre: {
    fr:{t:"Boutique Tijara",x:"Un lien à vous, un tableau de bord, et les commandes qui arrivent rangées."},
    ar:{t:"حانوت Tijara",x:"رابط خاص بيك، تابلو، والطلبات توصل مرتّبة."}
  }
};
const BASE = {
  fr:["Votre lien de boutique, à partager sur Facebook, Instagram ou TikTok",
      "Paiement à la livraison dans les 58 wilayas",
      "Commandes illimitées, produits illimités"],
  ar:["رابط الحانوت ديالك، تشاركو في فيسبوك، انستغرام ولا تيكتوك",
      "الخلاص عند التوصيل في 58 ولاية",
      "طلبات بلا حدود، منتجات بلا حدود"]
};
const PLUS = {
  perdues:{fr:"Chaque commande arrive dans votre tableau de bord — plus rien ne se perd dans les DM.",ar:"كل طلبية توصل للتابلو ديالك — ما بقاش شي يضيع في المسّاجات."},
  carnet:{fr:"Nom, téléphone et wilaya remplis par le client, déjà vérifiés.",ar:"السمية، التيليفون والولاية يعمّرهم الحريف، ومتحقّق منهم."},
  stock:{fr:"Un article épuisé ne peut plus être commandé, le stock se met à jour seul.",ar:"سلعة خلاصت ما تقدرش تتطلب، الستوك يتحدّث وحدو."},
  chiffre:{fr:"Votre chiffre en direct : commandes, ventes confirmées et taux de confirmation.",ar:"المداخيل مباشرة : الطلبات، المبيعات المؤكدة ونسبة التأكيد."},
  dm:{fr:"Un seul lien remplace les allers-retours en messages privés.",ar:"رابط واحد يعوّض الرواح والجاي في المسّاجات."},
  whatsapp:{fr:"Le formulaire fait la saisie à votre place — vous n'appelez que pour confirmer.",ar:"الاستمارة تكتب بلاصتك — غير تعيّط باش تأكد."},
  boutique:{fr:"Vos produits en magasin deviennent une boutique en ligne, sans double saisie.",ar:"سلعك في الحانوت تولي حانوت أونلاين، بلا ما تكتبهم مرتين."},
  rien:{fr:"Publicité générée pour vous : visuel et texte, prêts à publier.",ar:"إشهار يتصنعلك : الصورة والنص، واجدين للنشر."}
};
const TEXTES = {
  errEmail:{fr:"Entrez une adresse email valide.",ar:"دخل إيميل صحيح."},
  errNom:{fr:"Donnez un nom à votre boutique.",ar:"عطي سمية للحانوت ديالك."},
  tag:{fr:"Votre configuration",ar:"الإعدادات ديالك"},
  envoi:{fr:"Un instant…",ar:"شوية…"}
};

/* ================= langue ================= */
let langue = "fr";
function appliquerLangue(l){
  langue = l;
  document.documentElement.lang = l === "ar" ? "ar" : "fr";
  document.documentElement.dir = l === "ar" ? "rtl" : "ltr";
  document.body.classList.toggle("ar", l === "ar");
  document.getElementById("bFr").setAttribute("aria-pressed", l === "fr");
  document.getElementById("bAr").setAttribute("aria-pressed", l === "ar");
  document.querySelectorAll("[data-fr]").forEach(el => {
    el.innerHTML = el.dataset[l] || el.dataset.fr;
  });
  if (etape === 5) construireFiche();
}
document.getElementById("bFr").onclick = () => appliquerLangue("fr");
document.getElementById("bAr").onclick = () => appliquerLangue("ar");

/* ================= navigation ================= */
const reponses = {};
const TOTAL = 5;
let etape = 0;

function aller(n){
  etape = n;
  document.querySelectorAll(".etape").forEach(s =>
    s.classList.toggle("on", +s.dataset.e === n));
  const pct = Math.min(n / TOTAL * 100, 100);
  document.getElementById("fill").style.width = pct + "%";
  document.getElementById("rail").setAttribute("aria-valuenow", Math.round(pct));
  window.scrollTo(0, 0);
}

document.querySelectorAll("[data-suivant]").forEach(b => b.onclick = () => aller(etape + 1));
document.querySelectorAll("[data-retour]").forEach(b => b.onclick = () => aller(Math.max(0, etape - 1)));
document.querySelectorAll(".opt").forEach(b => b.onclick = () => {
  reponses[b.dataset.q] = b.dataset.v;
  aller(etape + 1);
});

/* ================= envoi ================= */
document.getElementById("envoyer").onclick = async function(){
  const nom = document.getElementById("nom").value.trim();
  const email = document.getElementById("email").value.trim();
  const err = document.getElementById("err");

  if (!nom){
    err.textContent = TEXTES.errNom[langue];
    err.style.display = "block";
    document.getElementById("nom").focus();
    return;
  }
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(email)){
    err.textContent = TEXTES.errEmail[langue];
    err.style.display = "block";
    document.getElementById("email").focus();
    return;
  }
  err.style.display = "none";

  reponses.boutique = nom;
  reponses.email = email;
  reponses.langue = langue;

  const texteInitial = this.textContent;
  this.disabled = true;
  this.textContent = TEXTES.envoi[langue];

  if (CONFIG.endpoint){
    try{
      const r = await fetch(CONFIG.endpoint, {
        method:"POST",
        headers:{"Content-Type":"application/json","Accept":"application/json"},
        body: JSON.stringify(pourFormspree(nom, email))
      });
      if (!r.ok) console.warn("Formspree a refusé l'envoi", r.status);
    }catch(e){ console.warn("Envoi impossible, on continue.", e); }
  }

  construireFiche();
  this.disabled = false;
  this.textContent = texteInitial;
  aller(5);
};

