    <button class="opt" data-q="canal" data-v="rien"><span class="ico">🌱</span><span><b data-fr="Je débute" data-ar="راني نبدا"></b><small data-fr="Je n'ai pas encore vendu" data-ar="مازال ما بعتش"></small></span></button>
