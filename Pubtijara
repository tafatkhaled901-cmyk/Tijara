</section>

<!-- 4 · capture -->
<section class="etape" data-e="4">
  <div class="compteur" data-fr="Dernière étape" data-ar="آخر خطوة"></div>
  <h2 data-fr="À quel nom sera votre boutique ?" data-ar="باش سمية يكون الحانوت ديالك ؟"></h2>
