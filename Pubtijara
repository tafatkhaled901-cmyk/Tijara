  <h2 data-fr="Comment recevez-vous vos commandes ?" data-ar="كيفاش توصلك الطلبات ؟"></h2>
  <p class="sous" data-fr="Aujourd'hui, avant Tijara." data-ar="اليوم، قبل Tijara."></p>
  <div class="choix">
    <button class="opt" data-q="canal" data-v="dm"><span class="ico">💬</span><span><b data-fr="Messages privés et commentaires" data-ar="مسّاجات وكومنتار"></b><small data-fr="Facebook, Instagram, TikTok" data-ar="فيسبوك، انستغرام، تيكتوك"></small></span></button>
    <button class="opt" data-q="canal" data-v="whatsapp"><span class="ico">📲</span><span><b data-fr="WhatsApp" data-ar="واتساب"></b><small data-fr="Le client écrit, vous notez" data-ar="الحريف يكتب، ونتا تسجّل"></small></span></button>
